      "pattern": "(?i)(hashlib\\.(md5|sha1)|MessageDigest\\.getInstance\\(\\s*[\"'](MD5|SHA-?1)|crypto\\.createHash\\(\\s*[\"'](md5|sha1)|md5\\(|sha1\\()",
